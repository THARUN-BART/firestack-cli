{
  "name": "rn-firebase",
  "version": "1.0.0",
  "description": "Unified Firebase Setup and Diagnostic CLI for React Native & Expo",
  "main": "index.ts",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "rn-firebase": "./bin/rn-firebase.mjs"
  },
  "scripts": {
