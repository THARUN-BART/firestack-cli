{
  "name": "rn-firebase-cli",
  "version": "1.0.0",
  "description": "Unified Firebase setup CLI for React Native & Expo — configure Android, iOS, and Web from a single command",
  "keywords": [
    "firebase",
    "react-native",
    "expo",
    "cli",
    "setup",
    "android",
    "ios",
    "web",
    "google-services",
    "firebase-tools",
    "react-native-firebase"
  ],
  "homepage": "https://github.com/tharunpoongavanam/rn-firebase-cli#readme",
  "bugs": {
    "url": "https://github.com/tharunpoongavanam/rn-firebase-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tharunpoongavanam/rn-firebase-cli.git"
  },
  "license": "MIT",
  "author": "Tharun Poongavanam <tharunpoongavanam@gmail.com>",
  "main": "dist/cli.js",
  "module": "dist/cli.js",
  "type": "module",
  "bin": {
    "rn-firebase-cli": "bin/rn-firebase.mjs",
    "rn-firebase": "bin/rn-firebase.mjs"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target node --outfile dist/cli.js",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "typescript": "^5 || ^7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
